{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .codex/hooks/pre_tool_use_policy.py",
                        "statusMessage": "TASK 경계와 위험 명령 정책을 확인하는 중"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .codex/hooks/post_tool_use_review.py",
                        "statusMessage": "명령 실행 결과와 저장소 상태를 확인하는 중"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .codex/hooks/stop_task_guard.py",
                        "statusMessage": "TASK 완료 조건을 확인하는 중",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}